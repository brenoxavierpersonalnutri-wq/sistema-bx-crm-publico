#!/usr/bin/env bash
# Entrega ao CRM, UMA vez, o IG_APP_ID e o IG_APP_SECRET do app da Meta (Instagram) sem ninguém colar no painel.
#
# De onde vem: o Breno guarda no Mac, no terminal dele, e o cofre leva pra VPS:
#   bash ~/.claude/head-turbo/bin/guardar-chave.sh IG_APP_ID --testar nenhum --levar-vps
#   bash ~/.claude/head-turbo/bin/guardar-chave.sh IG_APP_SECRET --testar nenhum --levar-vps
# Aqui (root, na VPS) o script lê os dois do cofre do usuário do kit (padrão /home/turbo/.config/head-turbo/cofre.env;
# outro caminho: HEADTURBO_COFRE=/caminho), lê o WA_PROXY_SECRET de /etc/headturbo-wa-proxy/proxy.env (já pareado
# com o CRM), assina "<ts>.<nonce>.<corpo>" com HMAC-SHA256 e faz POST (IPv4) em
# .../functions/v1/instagram-oauth?evento=parear. A função confere IP da VPS, uso único, janela de 5 min e nonce.
#
# Instalado em /usr/local/sbin/headturbo-ig-parear (root, 0700). Uso:
#   sudo headturbo-ig-parear             # seco: confere cofre, segredo HMAC e se a função aceita; nada é gravado
#   sudo headturbo-ig-parear --executar  # envia uma vez; mostra só status HTTP e o hash curto
#
# Nunca imprime segredo: só nomes, tamanhos, status e o hash (12 hex do sha256 do valor gravado), recalculado
# aqui pra conferir que o CRM gravou exatamente o que saiu daqui. Segredo nunca vai em argv: o corpo entra no
# curl por stdin, os cabeçalhos por --config num descritor (/dev/fd), e a chave do HMAC por variável de ambiente
# só do processo que assina.
# Rearmar (trocou o app secret na Meta): o dono roda no SQL  SELECT public.instagram_pareamento_reabrir();
set -euo pipefail
umask 077

URL="https://SEU_PROJECT_REF.supabase.co/functions/v1/instagram-oauth?evento=parear"
COFRE="${HEADTURBO_COFRE:-/home/turbo/.config/head-turbo/cofre.env}"
PROXY="/etc/headturbo-wa-proxy/proxy.env"
NOME="instagram-oauth?evento=parear"

EXECUTAR=0
for a in "$@"; do
  case "$a" in
    --executar) EXECUTAR=1 ;;
    -h|--help) sed -n '2,21p' "$0"; exit 0 ;;
    *) echo "PARADO: argumento desconhecido: $a (use --executar ou nada)"; exit 2 ;;
  esac
done

if [ "$(id -u)" -ne 0 ]; then
  echo "PARADO: rode como root (sudo)."
  exit 2
fi
for bin in curl python3 sha256sum; do
  command -v "$bin" >/dev/null 2>&1 || { echo "PARADO: falta o comando $bin."; exit 2; }
done

# Lê NOME=valor de um .env sem executar o arquivo (aceita "export ", aspas simples/duplas; vale a última linha).
ler_env() {
  local arq="$1" nome="$2" linha k v achou=""
  while IFS= read -r linha || [ -n "$linha" ]; do
    linha="${linha#"${linha%%[![:space:]]*}"}"
    linha="${linha#export }"
    case "$linha" in ''|'#'*) continue ;; esac
    [[ "$linha" == *=* ]] || continue
    k="${linha%%=*}"; k="${k%"${k##*[![:space:]]}"}"
    [ "$k" = "$nome" ] || continue
    v="${linha#*=}"
    v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
    if [ "${#v}" -ge 2 ]; then
      case "$v" in \"*\"|\'*\') v="${v:1:${#v}-2}" ;; esac
    fi
    achou="$v"
  done < "$arq"
  printf '%s' "$achou"
}

for arq in "$COFRE" "$PROXY"; do
  [ -r "$arq" ] || { echo "PARADO: não consegui ler $arq."; exit 2; }
done

APP_ID="$(ler_env "$COFRE" IG_APP_ID)"
APP_SECRET="$(ler_env "$COFRE" IG_APP_SECRET)"
SEGREDO_HMAC="$(ler_env "$PROXY" WA_PROXY_SECRET)"
APP_SECRET="${APP_SECRET,,}"   # a função grava em minúsculas: o hash tem de bater

id_ok=0; sec_ok=0
[[ "$APP_ID" =~ ^[0-9]{6,20}$ ]] && id_ok=1
[[ "$APP_SECRET" =~ ^[0-9a-f]{32}$ ]] && sec_ok=1
echo "$COFRE: IG_APP_ID=${#APP_ID} chars ($([ $id_ok = 1 ] && echo ok || echo 'FALTA/formato: só dígitos, 6-20'))" \
     "IG_APP_SECRET=${#APP_SECRET} chars ($([ $sec_ok = 1 ] && echo ok || echo 'FALTA/formato: 32 hex'))"
echo "$PROXY: WA_PROXY_SECRET=${#SEGREDO_HMAC} chars"
if [ $id_ok != 1 ] || [ $sec_ok != 1 ] || [ "${#SEGREDO_HMAC}" -lt 32 ]; then
  echo "PARADO: falta valor ou formato errado. Nada enviado."
  exit 1
fi

# Mesma forma que a função grava (validarCorpoIg -> JSON.stringify): só dígitos e hex, sem escape possível.
CORPO="{\"app_id\":\"${APP_ID}\",\"app_secret\":\"${APP_SECRET}\"}"
HASH_LOCAL="$(printf '%s' "$CORPO" | sha256sum | cut -c1-12)"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# POST na função; corpo por stdin, cabeçalhos por --config em /dev/fd. Ecoa o status HTTP; resposta em $TMP/resp.
postar() {
  local cabecalhos="$1" corpo="$2"
  printf '%s' "$corpo" | curl -4 -sS --max-time 30 -o "$TMP/resp" -w '%{http_code}' \
    --config <(printf '%s' "$cabecalhos") --data-binary @- "$URL" 2>/dev/null || true
}
campo_json() { # campo_json <arquivo> <chave>  (texto curto, sem quebrar se não for JSON)
  python3 -I -c 'import json,sys
try: print(str(json.load(open(sys.argv[1])).get(sys.argv[2], ""))[:120])
except Exception: print("")' "$1" "$2"
}

if [ $EXECUTAR != 1 ]; then
  # Sonda sem gravar: POST sem assinatura e corpo "{}". A função para antes de tocar no banco:
  #   401 = publicada, origem (IPv4 da VPS) aceita e pareamento aberto  -> pronto pro --executar
  #   410 = já pareado (rearmar no SQL) · 403 = origem recusada · 404 = não publicada
  # Não consome nonce: o nonce só é gravado depois da assinatura conferida.
  st="$(postar 'header = "Content-Type: application/json"' '{}')"; st="${st:-000}"
  case "$st" in
    401) echo "$NOME: HTTP 401 sem assinatura (publicada, origem aceita, pareamento aberto)" ;;
    410) echo "$NOME: HTTP 410 já pareado. Pra gravar de novo: o dono roda no SQL  SELECT public.instagram_pareamento_reabrir();" ;;
    403) echo "$NOME: HTTP 403 origem recusada (a função só aceita o IPv4 público da VPS)." ;;
    404) echo "$NOME: HTTP 404 função não publicada." ;;
    000) echo "$NOME: sem resposta." ;;
    *)   echo "$NOME: HTTP $st $(campo_json "$TMP/resp" error) (inesperado)" ;;
  esac
  echo "hash do que seria enviado: $HASH_LOCAL"
  echo "Meta: par não validado aqui (o app do Instagram Login não tem endpoint de checagem só com id+secret)."
  echo "SECO: nada foi gravado. Pra gravar: --executar"
  [ "$st" = 401 ] && exit 0 || exit 1
fi

TS="$(date +%s)"
NONCE="$(python3 -I -c 'import secrets; print(secrets.token_urlsafe(24))')"
ASSINATURA="$(printf '%s.%s.%s' "$TS" "$NONCE" "$CORPO" | HMAC_CHAVE="$SEGREDO_HMAC" python3 -I -c '
import hashlib, hmac, os, sys
print(hmac.new(os.environ["HMAC_CHAVE"].encode(), sys.stdin.buffer.read(), hashlib.sha256).hexdigest())')"
[[ "$NONCE" =~ ^[A-Za-z0-9_-]{16,64}$ ]] || { echo "PARADO: nonce inválido. Nada enviado."; exit 1; }
[[ "$ASSINATURA" =~ ^[0-9a-f]{64}$ ]] || { echo "PARADO: assinatura não calculada. Nada enviado."; exit 1; }

CAB="header = \"Content-Type: application/json\"
header = \"x-live-ts: ${TS}\"
header = \"x-live-nonce: ${NONCE}\"
header = \"x-live-assinatura: ${ASSINATURA}\""
st="$(postar "$CAB" "$CORPO")"; st="${st:-000}"

if [ "$st" = 200 ]; then
  hash_remoto="$(campo_json "$TMP/resp" hash)"
  if [ "$hash_remoto" = "$HASH_LOCAL" ]; then
    echo "$NOME: HTTP 200 hash=$hash_remoto (confere)"
    exit 0
  fi
  echo "$NOME: HTTP 200 hash=$hash_remoto (NAO CONFERE com o local $HASH_LOCAL)"
  exit 1
fi
if [ "$st" = 000 ]; then echo "PARADO: $NOME sem resposta (rede/DNS/IPv4). Nada gravado."; exit 1; fi
echo "$NOME: HTTP $st $(campo_json "$TMP/resp" error)"
case "$st" in
  410) echo "Já pareado. Pra gravar de novo: o dono roda no SQL  SELECT public.instagram_pareamento_reabrir();" ;;
  409) echo "Nonce repetido (não deveria acontecer): rode de novo." ;;
  403) echo "Origem recusada (a função só aceita o IPv4 público da VPS)." ;;
  401) echo "Assinatura recusada: relógio da VPS fora (janela 5 min) ou WA_PROXY_SECRET diferente do CRM." ;;
  400) echo "O CRM recusou o formato das chaves." ;;
  404) echo "Função não publicada ainda." ;;
esac
exit 1
