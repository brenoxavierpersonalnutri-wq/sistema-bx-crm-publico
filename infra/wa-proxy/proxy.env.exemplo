# /etc/headturbo-wa-proxy/proxy.env  (root:root 0600) — NUNCA versionar o arquivo real.
# WA_PROXY_SECRET: gerado na instalação (openssl rand -hex 32); o mesmo valor vai no
# secret WA_PROXY_SECRET do Lovable Cloud.
WA_PROXY_SECRET=
# OPENWA_OPERATOR_KEY: chave role=operator criada pelo dono no painel do OpenWA,
# allowedSessions = sessão "closer", allowedIps = 172.20.0.50 (IP fixo do proxy).
OPENWA_OPERATOR_KEY=
# Opcional: UUID da sessão closer. Vazio = o proxy procura pelo nome "closer".
OPENWA_SESSION_ID=
# Opcional (Central por número / Grupos): nomes das OUTRAS sessões OpenWA que o CRM pode usar
# (campo sessao no corpo assinado; vale em todas as rotas). Separados por vírgula. Vazio = só a sessão
# padrão (OPENWA_SESSION_NAME). A chave OPERATOR precisa ter essas sessões no allowedSessions.
# No Lovable Cloud, ligar também o secret WA_PROXY_MULTISESSAO=1.
OPENWA_SESSOES_EXTRAS=
# Multi-sessão (Central /crm/conexoes): nomes das sessões extras, separados por vírgula, e para CADA uma
# a chave operator restrita a ela (allowedSessions = id da sessão, allowedIps = 172.20.0.50) e o id.
# O nome vira sufixo: hífen -> _, maiúsculas. Gerado por headturbo-openwa-chave-sessao (nunca colar à mão no chat).
OPENWA_SESSOES_EXTRAS=
# OPENWA_OPERATOR_KEY_COMERCIAL_FIT_2=
# OPENWA_SESSION_ID_COMERCIAL_FIT_2=
